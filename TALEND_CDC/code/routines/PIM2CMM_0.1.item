        		returnString = "dia"+ PIM2CMM.formatDecimal(diameter, 2) + "-L" + PIM2CMM.formatDecimal(length, 2) + "-W" + PIM2CMM.formatDecimal(width, 2) + "-H" + PIM2CMM.formatDecimal(height, 2) + "inch";
        	}
        	//diameter == null
