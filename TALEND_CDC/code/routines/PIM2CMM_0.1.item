        		returnString = "W"+PIM2CMM.formatDecimal(width, 2)+"inch";
        	}
        	//width == null && height == null && diameter == null
        	else if(length != null && !length.isEmpty() &&
        			(width == null || width.isEmpty()) &&
        			(height == null || height.isEmpty()) &&
        			(diameter == null || diameter.isEmpty())){
