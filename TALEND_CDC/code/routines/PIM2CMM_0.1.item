        		returnString = "L" + PIM2CMM.formatDecimal(length, 2) + "-W" + PIM2CMM.formatDecimal(width, 2) + "-H" + PIM2CMM.formatDecimal(height, 2) + "inch";
        	}
        	//length == null
        	else if((length == null || length.isEmpty()) &&
        			diameter != null && !diameter.isEmpty() &&
        			width != null && !width.isEmpty() &&
        			height != null && !height.isEmpty()){
        		returnString = "dia" + PIM2CMM.formatDecimal(diameter, 2) + "-W" + PIM2CMM.formatDecimal(width, 2) + "-H" + PIM2CMM.formatDecimal(height, 2) + "inch";
        	}
        	//width == null
        	else if((width == null || width.isEmpty()) &&
        			diameter != null && !diameter.isEmpty() &&
        			length != null && !length.isEmpty() &&
        			height != null && !height.isEmpty()){
        		returnString = "dia" + PIM2CMM.formatDecimal(diameter, 2) + "-L" + PIM2CMM.formatDecimal(length, 2) + "-H" + PIM2CMM.formatDecimal(height, 2) + "inch";
        	}
        	//height == null
        	else if((height == null || height.isEmpty()) &&
        			diameter != null && !diameter.isEmpty() &&
        			length != null && !length.isEmpty() &&
        			width != null && !width.isEmpty()){
        		returnString = "dia" + PIM2CMM.formatDecimal(diameter, 2) + "-L" + PIM2CMM.formatDecimal(length, 2) + "-W" + PIM2CMM.formatDecimal(width, 2) + "inch";
        	}
        	//length == null && width == null
        	else if(diameter != null && !diameter.isEmpty() &&
        			height != null && !height.isEmpty() &&
        			(length == null || length.isEmpty()) &&
        			(width == null || width.isEmpty())){
        		returnString = "dia"+PIM2CMM.formatDecimal(diameter, 2)+"-H"+PIM2CMM.formatDecimal(height, 2)+"inch";
        	}
        	//length == null && height == null
        	else if(diameter != null && !diameter.isEmpty() &&
        			width != null && !width.isEmpty() &&
        			(length == null || length.isEmpty()) &&
        			(height == null || height.isEmpty())){
        		returnString = "dia"+PIM2CMM.formatDecimal(diameter, 2)+"-W"+PIM2CMM.formatDecimal(width, 2)+"inch";
        	}
        	//length == null && diameter == null
        	else if(height != null && !height.isEmpty() &&
        			width != null && !width.isEmpty() &&
        			(length == null || length.isEmpty()) &&
        			(diameter == null || diameter.isEmpty())){
        		returnString = "W"+PIM2CMM.formatDecimal(width, 2)+"-H"+PIM2CMM.formatDecimal(height, 2)+"inch";
        	}
        	//height == null && width == null
        	else if(length != null && !length.isEmpty() &&
        			diameter != null && !diameter.isEmpty() &&
        			(height == null || height.isEmpty()) &&
        			(width == null || width.isEmpty())){
        		returnString = "dia"+PIM2CMM.formatDecimal(diameter, 2)+"-L"+PIM2CMM.formatDecimal(length, 2)+"inch";
        	}
        	//height == null && diameter == null
        	else if(length != null && !length.isEmpty() &&
        			width != null && !width.isEmpty() &&
        			(height == null || height.isEmpty()) &&
        			(diameter == null || diameter.isEmpty())){
        		returnString = "L"+length+"-W"+width+"inch";
        	}
        	//width == null && diameter == null
        	else if(length != null && !length.isEmpty() &&
        			height != null && !height.isEmpty() &&
        			(width == null || width.isEmpty()) &&
        			(diameter == null || diameter.isEmpty())){
        		returnString = "L"+PIM2CMM.formatDecimal(length, 2)+"-H"+PIM2CMM.formatDecimal(height, 2)+"inch";
        	}
        	//length == null && width == null && height == null
        	else if(diameter != null && !diameter.isEmpty() &&
        			(length == null || length.isEmpty()) &&
        			(width == null || width.isEmpty()) &&
        			(height == null || height.isEmpty())){
        		returnString = "dia"+PIM2CMM.formatDecimal(diameter, 2)+"inch";
        	}
        	//length == null && width == null && diameter == null
        	else if(height != null && !height.isEmpty() &&
        			(length == null || length.isEmpty()) &&
        			(width == null || width.isEmpty()) &&
        			(diameter == null || diameter.isEmpty())){
        		returnString = "H"+PIM2CMM.formatDecimal(height, 2)+"inch";
        	}
        	//length == null && height == null && diameter == null
        	else if(width != null && !width.isEmpty() &&
        			(length == null || length.isEmpty()) &&
