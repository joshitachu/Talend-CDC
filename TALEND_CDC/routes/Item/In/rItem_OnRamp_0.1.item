  <node xmi:id="_7EN2N-jFEe-j45hcHrcI1Q" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="320" posY="240">
    <elementParameter xmi:id="_7EN2OOjFEe-j45hcHrcI1Q" field="TEXT" name="UNIQUE_NAME" value="cProcessor_1" show="false"/>
    <elementParameter xmi:id="_7EN2OejFEe-j45hcHrcI1Q" field="MEMO_JAVA" name="CODE" value="exchange.getIn().setHeader(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;,TalendDate.getCurrentDate()));&#xA;exchange.getIn().setHeader(&quot;startTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd'T'HHmmss.SSS'Z'&quot;,TalendDate.getCurrentDate()));&#xA;exchange.getIn().setHeader(&quot;Description&quot;, &quot;Triggered '&quot;+ (String)exchange.getIn().getHeader(&quot;ProducerKey&quot;) + &quot;' event. &quot;);&#xA;&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionJobName&quot;, camelContext.getName());&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionJobVersion&quot;, camelContext.getVersion());&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionProjectName&quot;, &quot;VAXXINOVA&quot;);"/>
    <elementParameter xmi:id="_7EN2OujFEe-j45hcHrcI1Q" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
