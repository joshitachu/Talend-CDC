      <elementValue xmi:id="_7EN2qujFEe-j45hcHrcI1Q" elementRef="NAME" value="&quot;IntegrationRunId_SubNr&quot;"/>
      <elementValue xmi:id="_7EN2q-jFEe-j45hcHrcI1Q" elementRef="LANGUAGE" value="constant"/>
      <elementValue xmi:id="_7EN2rOjFEe-j45hcHrcI1Q" elementRef="EXPRESSION" value="&quot;&quot;"/>
      <elementValue xmi:id="_7EN2rejFEe-j45hcHrcI1Q" elementRef="NAME" value="&quot;CMM&quot;"/>
      <elementValue xmi:id="_7EN2rujFEe-j45hcHrcI1Q" elementRef="LANGUAGE" value="simple"/>
      <elementValue xmi:id="_7EN2r-jFEe-j45hcHrcI1Q" elementRef="EXPRESSION" value="&quot;${in.header.CMM}&quot;"/>
