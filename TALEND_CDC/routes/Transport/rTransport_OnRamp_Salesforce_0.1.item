  <node componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="672" posY="1056" xmi:id="_TzxwX-MEEe-V3tuhkuiEbQ">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="cProcessor_4" xmi:id="_TzxwYOMEEe-V3tuhkuiEbQ"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="/*&#10;* Provide own codes to consume or translate the message exchanges.&#10;* @param org.apache.camel.Exchange exchange&#10;*/&#10;String env = (String)exchange.getIn().getHeader(&quot;Environment&quot;);&#10;String cmm = (String)exchange.getIn().getHeader(&quot;CMM&quot;);&#10;String procesNr = (String)exchange.getIn().getHeader(&quot;ProcessingStepNr&quot;);&#10;String procesStat = (String)exchange.getIn().getHeader(&quot;ProcessingStepStatus&quot;);&#10;String messageOutHeader = (String)exchange.getIn().getHeader(&quot;MessageOut&quot;);&#10;&#10;if(env==null||&quot;&quot;.equals(env))&#10;{&#10;&#9;env = contextStr;&#10;}&#10;else if (cmm==null||&quot;&quot;.equals(cmm))&#10;{&#10;&#9;cmm = &quot;CMM_Unknown&quot;;&#10;}&#10;else if (procesNr==null||&quot;&quot;.equals(procesNr))&#10;{&#10;&#9;procesNr = &quot;0&quot;;&#10;}&#10;else if (procesStat==null||&quot;&quot;.equals(procesStat))&#10;{&#10;&#9;procesStat = &quot;Status_Unknown&quot;;&#10;}&#10;else if (messageOutHeader==null||&quot;&quot;.equals(messageOutHeader))&#10;{&#10;&#9;messageOutHeader = (String)exchange.getIn().getHeader(&quot;body&quot;);&#10;&#9;String messageOut = messageOutHeader;&#10;&#9;//messageOut = StringEscapeUtils.escapeJava(messageOutHeader);&#10;}&#10;&#10;String newMessageIn = (String)exchange.getIn().getHeader(&quot;MessageIn&quot;);&#10;//newMessageIn = StringEscapeUtils.escapeJava((String)exchange.getIn().getHeader(&quot;MessageIn&quot;));&#10;&#10;String newError = (String)exchange.getIn().getHeader(&quot;Error&quot;);&#10;//newError = StringEscapeUtils.escapeJava((String)exchange.getIn().getHeader(&quot;Error&quot;));&#10;&#10;JSONObject json = new JSONObject();&#10;json.put(&quot;start&quot;,(String)exchange.getIn().getHeader(&quot;startTime&quot;));&#10;json.put(&quot;end&quot;,TalendDate.formatDateInUTC(&quot;yyyyMMdd'T'HHmmss.SSS'Z'&quot;,TalendDate.getCurrentDate()));&#10;json.put(&quot;Producer&quot;,(String)exchange.getIn().getHeader(&quot;Producer&quot;));&#10;json.put(&quot;ProducerKey&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKey&quot;));&#10;json.put(&quot;ProducerKeyId&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKeyId&quot;));&#10;json.put(&quot;IntegrationRunId&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId&quot;));&#10;json.put(&quot;IntegrationRunId_SubNr&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId_SubNr&quot;));&#10;json.put(&quot;Environment&quot;,env);&#10;json.put(&quot;CMM&quot;,cmm);&#10;json.put(&quot;Interface&quot;,(String)exchange.getIn().getHeader(&quot;Interface&quot;));&#10;json.put(&quot;ProcessingStep&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStep&quot;));&#10;json.put(&quot;ProcessingStepNr&quot;,procesNr);&#10;json.put(&quot;ProcessingStepTotal&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStepTotal&quot;));&#10;json.put(&quot;ProcessingStepStatus&quot;,procesStat);&#10;json.put(&quot;Consumer&quot;,(String)exchange.getIn().getHeader(&quot;Consumer&quot;));&#10;json.put(&quot;ConsumerKey&quot;,(String)exchange.getIn().getHeader(&quot;ConsumerKey&quot;));&#10;json.put(&quot;Description&quot;,(String)exchange.getIn().getHeader(&quot;Description&quot;));&#10;json.put(&quot;Error&quot;,newError);&#10;json.put(&quot;Link&quot;,(String)exchange.getIn().getHeader(&quot;Link&quot;));&#10;json.put(&quot;MessageIn&quot;,newMessageIn);&#10;json.put(&quot;MessageOut&quot;,messageOutHeader);&#10;json.put(&quot;Webservice&quot;,(String)exchange.getIn().getHeader(&quot;Webservice&quot;));&#10;json.put(&quot;MonitoringSessionPid&quot;,&quot;pid&quot;);&#10;json.put(&quot;MonitoringSessionRootPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#10;json.put(&quot;MonitoringSessionFatherPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#10;json.put(&quot;MonitoringSessionJobName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobName&quot;));&#10;json.put(&quot;MonitoringSessionJobVersion&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobVersion&quot;));&#10;json.put(&quot;MonitoringSessionProjectName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionProjectName&quot;));&#10;&#10;exchange.getIn().setHeader(&quot;KibanaDocID&quot;, (TalendDate.formatDate(&quot;yyyyMMdd&quot;,TalendDate.getCurrentDate()) + &quot;_&quot; + (String)exchange.getIn().getHeader(&quot;InterfaceRunId&quot;)+&quot;_&quot;+(String)exchange.getIn().getHeader(&quot;ProcessingStep&quot;)+&quot;_&quot;+procesNr+&quot;_&quot;+(String)exchange.getIn().getHeader(&quot;startTime&quot;)).replace(&quot;.&quot;, &quot;_&quot;));&#10;&#10;String message;&#10;message = json.toString();&#10;&#10;exchange.getIn().setBody(message);&#10;System.out.println(message);" xmi:id="_TzxwYeMEEe-V3tuhkuiEbQ"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#10;&#10;&#10;&#10;&#10;" xmi:id="_TzxwYuMEEe-V3tuhkuiEbQ"/>
