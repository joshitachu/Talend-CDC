  <node componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="288" posY="192" xmi:id="_NauOLuMyEe-SlfsEjyHROQ">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="cProcessor_3" xmi:id="_NauOL-MyEe-SlfsEjyHROQ"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="try {&#10;    // Get the incoming message body as a String&#10;    String webhook_message = exchange.getIn().getBody(String.class);&#10;    &#10;    // Check if the message is not null&#10;    if (webhook_message != null) {&#10;        // Parse the JSON string using ObjectMapper (Jackson)&#10;        ObjectMapper objectMapper = new ObjectMapper();&#10;        Map&lt;String, Object&gt; jsonMap = objectMapper.readValue(webhook_message, Map.class);&#10;&#10;        // Validate the keys in the JSON to match 'Item' message&#10;        if (jsonMap.containsKey(&quot;status&quot;) &amp;&amp; &#10;            jsonMap.containsKey(&quot;productCode&quot;) &amp;&amp; &#10;            jsonMap.containsKey(&quot;name&quot;)) {&#10;            &#10;            // Process the message further if validation is successful&#10;            String status = (String) jsonMap.get(&quot;status&quot;);&#10;            String productCode = (String) jsonMap.get(&quot;productCode&quot;);&#10;            String name = (String) jsonMap.get(&quot;name&quot;);&#10;            String resourceType = &quot;items&quot;;&#10;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#10;            exchange.getIn().setHeader(&quot;ResourceId&quot;, productCode);&#10;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#10;            exchange.getProperties().put(&quot;ResourceId&quot;, productCode);&#10;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#10;            //log.warn(&quot;Valid message received: status={}, productCode={}, name={}&quot;, status, productCode, name);&#10;            &#10;        } &#10;        // Validate the keys in the JSON to match 'Account' message&#10;        else if (jsonMap.containsKey(&quot;name&quot;) &amp;&amp; &#10;                 jsonMap.containsKey(&quot;accountId&quot;)) {&#10;            &#10;            // Process the message in the second format&#10;            String name = (String) jsonMap.get(&quot;name&quot;);&#10;            String accountId = (String) jsonMap.get(&quot;accountId&quot;);&#10;            String resourceType = &quot;accounts&quot;;&#10;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#10;            exchange.getIn().setHeader(&quot;ResourceId&quot;, accountId);&#10;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#10;            exchange.getProperties().put(&quot;ResourceId&quot;, accountId);&#10;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#10;            //log.warn(&quot;Valid message received: name={}, accountId={}&quot;, name, accountId);&#10;&#10;        }&#10;        // Validate the keys in the JSON to match 'Shipment Order' message&#10;        else if (jsonMap.containsKey(&quot;status&quot;) &amp;&amp; &#10;                 jsonMap.containsKey(&quot;shipmentOrderNumber&quot;) &amp;&amp; &#10;                 jsonMap.containsKey(&quot;productNumber&quot;)) {&#10;            &#10;            // Process the message in the second format&#10;            String status = (String) jsonMap.get(&quot;status&quot;);&#10;            String shipmentOrderNumber = (String) jsonMap.get(&quot;shipmentOrderNumber&quot;);&#10;            String productNumber = (String) jsonMap.get(&quot;productNumber&quot;);&#10;            String resourceType = &quot;shipmentOrder&quot;;&#10;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#10;            exchange.getIn().setHeader(&quot;ResourceId&quot;, shipmentOrderNumber);&#10;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#10;            exchange.getProperties().put(&quot;ResourceId&quot;, shipmentOrderNumber);&#10;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#10;            //log.warn(&quot;Valid message received: name={}, accountId={}&quot;, name, accountId);&#10;&#10;        } else {&#10;            log.warn(&quot;Message keys do not match the required format&quot;);&#10;        }&#10;    } else {&#10;        log.warn(&quot;Webhook message is null&quot;);&#10;    }&#10;} catch (Exception ex) {&#10;    log.error(&quot;An unexpected error occurred: &quot;, ex);&#10;}" xmi:id="_NauOMOMyEe-SlfsEjyHROQ"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import com.fasterxml.jackson.databind.ObjectMapper;&#10;import org.apache.camel.Exchange;&#10;import java.util.List;&#10;import java.util.Map;" xmi:id="_NauOMeMyEe-SlfsEjyHROQ"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row" xmi:id="_NauOMuMyEe-SlfsEjyHROQ"/>
    <elementParameter field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;" xmi:id="_NauOM-MyEe-SlfsEjyHROQ"/>
  </node>
