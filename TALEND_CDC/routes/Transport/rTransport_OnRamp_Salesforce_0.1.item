    <elementParameter field="MEMO_JAVA" name="CODE" value="exchange.getIn().setHeader(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;,TalendDate.getCurrentDate()));&#10;exchange.getIn().setHeader(&quot;startTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd'T'HHmmss.SSS'Z'&quot;,TalendDate.getCurrentDate()));&#10;exchange.getIn().setHeader(&quot;Description&quot;, &quot;Triggered '&quot;+ (String)exchange.getIn().getHeader(&quot;ProducerKey&quot;) + &quot;' event. &quot;);&#10;exchange.getIn().setHeader(&quot;MonitoringSessionJobName&quot;, camelContext.getName());&#10;exchange.getIn().setHeader(&quot;MonitoringSessionJobVersion&quot;, camelContext.getVersion());&#10;exchange.getIn().setHeader(&quot;MonitoringSessionProjectName&quot;, &quot;VAXXINOVA&quot;);" xmi:id="_NauOs-MyEe-SlfsEjyHROQ"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;" xmi:id="_NauOtOMyEe-SlfsEjyHROQ"/>
    <elementParameter field="TEXT" name="LABEL" value="parseStartTime&lt;br&gt;&lt;b&gt;Add Headers&lt;/b&gt;" xmi:id="_NauOteMyEe-SlfsEjyHROQ"/>
