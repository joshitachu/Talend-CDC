  <node componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="288" posY="192" xmi:id="_TzdAqeMEEe-V3tuhkuiEbQ">
    <elementParameter field="TEXT" name="UNIQUE_NAME" show="false" value="cProcessor_3" xmi:id="_TzdAquMEEe-V3tuhkuiEbQ"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="try {&#10;    // Get the incoming message body as a String&#10;    String webhook_message = exchange.getIn().getBody(String.class);&#10;    &#10;    // Check if the message is not null&#10;    if (webhook_message != null) {&#10;        // Parse the JSON string using ObjectMapper (Jackson)&#10;        ObjectMapper objectMapper = new ObjectMapper();&#10;        Map&lt;String, Object&gt; jsonMap = objectMapper.readValue(webhook_message, Map.class);&#10;&#10;        // Assign each item to a variable&#10;        String subscriptionId = (String) jsonMap.get(&quot;subscriptionId&quot;);&#10;        String clientState = (String) jsonMap.get(&quot;clientState&quot;);&#10;        String expirationDateTime = (String) jsonMap.get(&quot;expirationDateTime&quot;);&#10;        String resource = (String) jsonMap.get(&quot;resource&quot;);&#10;        String changeType = (String) jsonMap.get(&quot;changeType&quot;);&#10;        String lastModifiedDateTime = (String) jsonMap.get(&quot;lastModifiedDateTime&quot;);&#10;&#9;&#9;&#10;        // Extract 'environment' from the URL (between &quot;/v2.0/&quot; and &quot;/api/&quot;)&#10;        String environment = resource.split(&quot;/v2.0/&quot;)[1].split(&quot;/api&quot;)[0];&#10;        // Extract 'company' (between 'companies(' and ')')&#10;        String company = resource.split(&quot;companies\\(&quot;)[1].split(&quot;\\)&quot;)[0];&#10;        // Extract 'resourceType' (after the company and before '(')&#10;        String resourceType = resource.split(&quot;companies\\(&quot;)[1].split(&quot;\\)&quot;)[1].split(&quot;\\(&quot;)[0].replace(&quot;/&quot;, &quot;&quot;);&#10;        // Extract 'resourceId' (after the 'resourceType' and between '(' and ')')&#10;        String resourceId = resource.split(&quot;\\(&quot;)[2].split(&quot;\\)&quot;)[0];&#10;        &#10;        // Add variables to exchange headers&#10;        exchange.getIn().setHeader(&quot;subscriptionId&quot;, subscriptionId);&#10;        exchange.getIn().setHeader(&quot;clientState&quot;, clientState);&#10;        exchange.getIn().setHeader(&quot;expirationDateTime&quot;, expirationDateTime);&#10;        exchange.getIn().setHeader(&quot;resource&quot;, resource);&#10;        exchange.getIn().setHeader(&quot;changeType&quot;, changeType);&#10;        exchange.getIn().setHeader(&quot;lastModifiedDateTime&quot;, lastModifiedDateTime);&#10;        exchange.getIn().setHeader(&quot;environment&quot;, environment);&#10;        exchange.getIn().setHeader(&quot;company&quot;, company);&#10;        exchange.getIn().setHeader(&quot;resourceType&quot;, resourceType);&#10;        exchange.getIn().setHeader(&quot;resourceId&quot;, resourceId);&#10;        exchange.getProperties().put(&quot;company&quot;, company);&#10;        exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#10;        exchange.getProperties().put(&quot;resourceId&quot;, resourceId);&#10;        exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#10;        exchange.getIn().setBody(resource);&#10;&#10;    } else {&#10;        log.warn(&quot;Webhook message is null&quot;);&#10;    }&#10;} catch (Exception ex) {&#10;    log.error(&quot;An unexpected error occurred: &quot;, ex);&#10;}&#10;" xmi:id="_TzdAq-MEEe-V3tuhkuiEbQ"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import org.apache.camel.Exchange;&#10;//import org.apache.cxf.message.MessageContentsList;&#10;import com.fasterxml.jackson.databind.ObjectMapper;&#10;import java.util.Map;&#10;import java.util.List;" xmi:id="_TzdArOMEEe-V3tuhkuiEbQ"/>
