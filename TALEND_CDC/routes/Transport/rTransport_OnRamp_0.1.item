    <elementParameter xmi:id="_naKQUOihEe-j45hcHrcI1Q" field="MEMO_JAVA" name="CODE" value="exchange.getIn().setHeader(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;,TalendDate.getCurrentDate()));&#xA;exchange.getIn().setHeader(&quot;startTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd'T'HHmmss.SSS'Z'&quot;,TalendDate.getCurrentDate()));&#xA;exchange.getIn().setHeader(&quot;Description&quot;, &quot;Triggered '&quot;+ (String)exchange.getIn().getHeader(&quot;ProducerKey&quot;) + &quot;' event. &quot;);&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionJobName&quot;, camelContext.getName());&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionJobVersion&quot;, camelContext.getVersion());&#xA;exchange.getIn().setHeader(&quot;MonitoringSessionProjectName&quot;, &quot;VAXXINOVA&quot;);"/>
    <elementParameter xmi:id="_naKQUeihEe-j45hcHrcI1Q" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter xmi:id="_naKQUuihEe-j45hcHrcI1Q" field="TEXT" name="LABEL" value="parseStartTime&lt;br>&lt;b>Add Headers&lt;/b>"/>
    <elementParameter xmi:id="_naKQU-ihEe-j45hcHrcI1Q" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
