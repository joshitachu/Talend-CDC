  <node xmi:id="_DocbJuh0Ee-fEOmmmXQ0Wg" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="840" posY="1080">
    <elementParameter xmi:id="_DocbJ-h0Ee-fEOmmmXQ0Wg" field="TEXT" name="UNIQUE_NAME" value="cProcessor_4" show="false"/>
    <elementParameter xmi:id="_DocbKOh0Ee-fEOmmmXQ0Wg" field="MEMO_JAVA" name="CODE" value="/*&#xA;* Provide own codes to consume or translate the message exchanges.&#xA;* @param org.apache.camel.Exchange exchange&#xA;*/&#xA;String env = (String)exchange.getIn().getHeader(&quot;Environment&quot;);&#xA;String cmm = (String)exchange.getIn().getHeader(&quot;CMM&quot;);&#xA;String procesNr = (String)exchange.getIn().getHeader(&quot;ProcessingStepNr&quot;);&#xA;String procesStat = (String)exchange.getIn().getHeader(&quot;ProcessingStepStatus&quot;);&#xA;String messageOutHeader = (String)exchange.getIn().getHeader(&quot;MessageOut&quot;);&#xA;&#xA;if(env==null||&quot;&quot;.equals(env))&#xA;{&#xA;&#x9;env = contextStr;&#xA;}&#xA;else if (cmm==null||&quot;&quot;.equals(cmm))&#xA;{&#xA;&#x9;cmm = &quot;CMM_Unknown&quot;;&#xA;}&#xA;else if (procesNr==null||&quot;&quot;.equals(procesNr))&#xA;{&#xA;&#x9;procesNr = &quot;0&quot;;&#xA;}&#xA;else if (procesStat==null||&quot;&quot;.equals(procesStat))&#xA;{&#xA;&#x9;procesStat = &quot;Status_Unknown&quot;;&#xA;}&#xA;else if (messageOutHeader==null||&quot;&quot;.equals(messageOutHeader))&#xA;{&#xA;&#x9;messageOutHeader = (String)exchange.getIn().getHeader(&quot;body&quot;);&#xA;&#x9;String messageOut = messageOutHeader;&#xA;&#x9;//messageOut = StringEscapeUtils.escapeJava(messageOutHeader);&#xA;}&#xA;&#xA;String newMessageIn = (String)exchange.getIn().getHeader(&quot;MessageIn&quot;);&#xA;//newMessageIn = StringEscapeUtils.escapeJava((String)exchange.getIn().getHeader(&quot;MessageIn&quot;));&#xA;&#xA;String newError = (String)exchange.getIn().getHeader(&quot;Error&quot;);&#xA;//newError = StringEscapeUtils.escapeJava((String)exchange.getIn().getHeader(&quot;Error&quot;));&#xA;&#xA;JSONObject json = new JSONObject();&#xA;json.put(&quot;start&quot;,(String)exchange.getIn().getHeader(&quot;startTime&quot;));&#xA;json.put(&quot;end&quot;,TalendDate.formatDateInUTC(&quot;yyyyMMdd'T'HHmmss.SSS'Z'&quot;,TalendDate.getCurrentDate()));&#xA;json.put(&quot;Producer&quot;,(String)exchange.getIn().getHeader(&quot;Producer&quot;));&#xA;json.put(&quot;ProducerKey&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKey&quot;));&#xA;json.put(&quot;ProducerKeyId&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKeyId&quot;));&#xA;json.put(&quot;IntegrationRunId&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId&quot;));&#xA;json.put(&quot;IntegrationRunId_SubNr&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId_SubNr&quot;));&#xA;json.put(&quot;Environment&quot;,env);&#xA;json.put(&quot;CMM&quot;,cmm);&#xA;json.put(&quot;Interface&quot;,(String)exchange.getIn().getHeader(&quot;Interface&quot;));&#xA;json.put(&quot;ProcessingStep&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStep&quot;));&#xA;json.put(&quot;ProcessingStepNr&quot;,procesNr);&#xA;json.put(&quot;ProcessingStepTotal&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStepTotal&quot;));&#xA;json.put(&quot;ProcessingStepStatus&quot;,procesStat);&#xA;json.put(&quot;Consumer&quot;,(String)exchange.getIn().getHeader(&quot;Consumer&quot;));&#xA;json.put(&quot;ConsumerKey&quot;,(String)exchange.getIn().getHeader(&quot;ConsumerKey&quot;));&#xA;json.put(&quot;Description&quot;,(String)exchange.getIn().getHeader(&quot;Description&quot;));&#xA;json.put(&quot;Error&quot;,newError);&#xA;json.put(&quot;Link&quot;,(String)exchange.getIn().getHeader(&quot;Link&quot;));&#xA;json.put(&quot;MessageIn&quot;,newMessageIn);&#xA;json.put(&quot;MessageOut&quot;,messageOutHeader);&#xA;json.put(&quot;Webservice&quot;,(String)exchange.getIn().getHeader(&quot;Webservice&quot;));&#xA;json.put(&quot;MonitoringSessionPid&quot;,&quot;pid&quot;);&#xA;json.put(&quot;MonitoringSessionRootPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#xA;json.put(&quot;MonitoringSessionFatherPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#xA;json.put(&quot;MonitoringSessionJobName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobName&quot;));&#xA;json.put(&quot;MonitoringSessionJobVersion&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobVersion&quot;));&#xA;json.put(&quot;MonitoringSessionProjectName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionProjectName&quot;));&#xA;&#xA;exchange.getIn().setHeader(&quot;KibanaDocID&quot;, (TalendDate.formatDate(&quot;yyyyMMdd&quot;,TalendDate.getCurrentDate()) + &quot;_&quot; + (String)exchange.getIn().getHeader(&quot;InterfaceRunId&quot;)+&quot;_&quot;+(String)exchange.getIn().getHeader(&quot;ProcessingStep&quot;)+&quot;_&quot;+procesNr+&quot;_&quot;+(String)exchange.getIn().getHeader(&quot;startTime&quot;)).replace(&quot;.&quot;, &quot;_&quot;));&#xA;&#xA;String message;&#xA;message = json.toString();&#xA;&#xA;exchange.getIn().setBody(message);&#xA;System.out.println(message);"/>
    <elementParameter xmi:id="_DocbKeh0Ee-fEOmmmXQ0Wg" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;&#xA;&#xA;&#xA;&#xA;"/>
    <elementParameter xmi:id="_DocbKuh0Ee-fEOmmmXQ0Wg" field="TEXT" name="LABEL" value="__UNIQUE_NAME__&lt;br>&lt;b>Create JSON&lt;/b>"/>
    <elementParameter xmi:id="_DocbK-h0Ee-fEOmmmXQ0Wg" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_DocbLOh0Ee-fEOmmmXQ0Wg" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
