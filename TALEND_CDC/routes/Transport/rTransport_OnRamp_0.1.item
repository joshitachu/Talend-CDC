  <node xmi:id="_4EZdauh1Ee-fEOmmmXQ0Wg" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="320" posY="240">
    <elementParameter xmi:id="_4EZda-h1Ee-fEOmmmXQ0Wg" field="TEXT" name="UNIQUE_NAME" value="cProcessor_3" show="false"/>
    <elementParameter xmi:id="_4EZdbOh1Ee-fEOmmmXQ0Wg" field="MEMO_JAVA" name="CODE" value="try {&#xA;    // Get the incoming message body as a String&#xA;    String webhook_message = exchange.getIn().getBody(String.class);&#xA;    &#xA;    // Check if the message is not null&#xA;    if (webhook_message != null) {&#xA;        // Parse the JSON string using ObjectMapper (Jackson)&#xA;        ObjectMapper objectMapper = new ObjectMapper();&#xA;        Map&lt;String, Object> jsonMap = objectMapper.readValue(webhook_message, Map.class);&#xA;&#xA;        // Validate the keys in the JSON to match 'Item' message&#xA;        if (jsonMap.containsKey(&quot;status&quot;) &amp;&amp; &#xA;            jsonMap.containsKey(&quot;productCode&quot;) &amp;&amp; &#xA;            jsonMap.containsKey(&quot;name&quot;)) {&#xA;            &#xA;            // Process the message further if validation is successful&#xA;            String status = (String) jsonMap.get(&quot;status&quot;);&#xA;            String productCode = (String) jsonMap.get(&quot;productCode&quot;);&#xA;            String name = (String) jsonMap.get(&quot;name&quot;);&#xA;            String resourceType = &quot;items&quot;;&#xA;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#xA;            exchange.getIn().setHeader(&quot;ResourceId&quot;, productCode);&#xA;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#xA;            exchange.getProperties().put(&quot;ResourceId&quot;, productCode);&#xA;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#xA;            //log.warn(&quot;Valid message received: status={}, productCode={}, name={}&quot;, status, productCode, name);&#xA;            &#xA;        } &#xA;        // Validate the keys in the JSON to match 'Account' message&#xA;        else if (jsonMap.containsKey(&quot;name&quot;) &amp;&amp; &#xA;                 jsonMap.containsKey(&quot;accountId&quot;)) {&#xA;            &#xA;            // Process the message in the second format&#xA;            String name = (String) jsonMap.get(&quot;name&quot;);&#xA;            String accountId = (String) jsonMap.get(&quot;accountId&quot;);&#xA;            String resourceType = &quot;accounts&quot;;&#xA;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#xA;            exchange.getIn().setHeader(&quot;ResourceId&quot;, accountId);&#xA;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#xA;            exchange.getProperties().put(&quot;ResourceId&quot;, accountId);&#xA;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#xA;            //log.warn(&quot;Valid message received: name={}, accountId={}&quot;, name, accountId);&#xA;&#xA;        }&#xA;        // Validate the keys in the JSON to match 'Shipment Order' message&#xA;        else if (jsonMap.containsKey(&quot;status&quot;) &amp;&amp; &#xA;                 jsonMap.containsKey(&quot;shipmentOrderNumber&quot;) &amp;&amp; &#xA;                 jsonMap.containsKey(&quot;productNumber&quot;)) {&#xA;            &#xA;            // Process the message in the second format&#xA;            String status = (String) jsonMap.get(&quot;status&quot;);&#xA;            String shipmentOrderNumber = (String) jsonMap.get(&quot;shipmentOrderNumber&quot;);&#xA;            String productNumber = (String) jsonMap.get(&quot;productNumber&quot;);&#xA;            String resourceType = &quot;shipmentOrder&quot;;&#xA;            exchange.getIn().setHeader(&quot;ResourceType&quot;, resourceType);&#xA;            exchange.getIn().setHeader(&quot;ResourceId&quot;, shipmentOrderNumber);&#xA;            exchange.getProperties().put(&quot;resourceType&quot;, resourceType);&#xA;            exchange.getProperties().put(&quot;ResourceId&quot;, shipmentOrderNumber);&#xA;            exchange.getProperties().put(&quot;currentTime&quot;, TalendDate.formatDateInUTC(&quot;yyyyMMdd_HHmmss&quot;, TalendDate.getCurrentDate()));&#xA;            //log.warn(&quot;Valid message received: name={}, accountId={}&quot;, name, accountId);&#xA;&#xA;        } else {&#xA;            log.warn(&quot;Message keys do not match the required format&quot;);&#xA;        }&#xA;    } else {&#xA;        log.warn(&quot;Webhook message is null&quot;);&#xA;    }&#xA;} catch (Exception ex) {&#xA;    log.error(&quot;An unexpected error occurred: &quot;, ex);&#xA;}"/>
    <elementParameter xmi:id="_4EZdbeh1Ee-fEOmmmXQ0Wg" field="MEMO_IMPORT" name="IMPORT" value="import com.fasterxml.jackson.databind.ObjectMapper;&#xA;import org.apache.camel.Exchange;&#xA;import java.util.List;&#xA;import java.util.Map;"/>
    <elementParameter xmi:id="_4EZdbuh1Ee-fEOmmmXQ0Wg" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_4EZdb-h1Ee-fEOmmmXQ0Wg" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
