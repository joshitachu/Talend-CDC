    <elementParameter xmi:id="_OOGUweh1Ee-fEOmmmXQ0Wg" field="MEMO_JAVA" name="CODE" value="System.out.println(&quot;Header, KibanaDocId H: &quot;+ exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class));&#xA;&#xA;// Create a random KibanaDocID if value = &quot;&quot;&#xA;if (&quot;&quot;.equals(exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class)) || exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class)==null)&#xA;{&#xA;&#x9;exchange.getIn().setHeader(&quot;KibanaDocId&quot;, TalendDate.formatDate(&quot;yyyyMMdd_HHmmss_SSS&quot;,TalendDate.getCurrentDate()));&#xA;&#x9;System.out.println(&quot;Header, KibanaDocId H2: &quot;+ exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class));&#xA;}&#xA;&#xA;context.Monitoring_Kibana_DocId = exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class);&#xA;&#xA;// cREST Dynamic URL.&#xA;//String new_RelativePath = context.Monitoring_URL+&quot;:&quot;+context.Monitoring_Port+context.Monitoring_EndPointTemp + ;&#xA;String new_RelativePath = exchange.getIn().getHeader(&quot;KibanaDocId&quot;, String.class);&#xA;System.out.println(&quot;new_RelativePath: &quot;+ new_RelativePath);&#xA;&#xA;//exchange.getIn().setHeader(Exchange.DESTINATION_OVERRIDE_URL, new_RelativePath);&#xA;exchange.getIn().setHeader(Exchange.HTTP_PATH, new_RelativePath);&#xA;&#xA;//Set Authorization header&#xA;String auth = context.Monitoring_authUsername+&quot;:&quot;+context.Monitoring_authPassword;&#xA;byte[] bytes = auth.getBytes();&#xA;&#xA;String s = Base64.getEncoder().encodeToString(bytes);&#xA;&#xA;exchange.getIn().setHeader(&quot;Authorization&quot;, context.Monitoring_authMethod + &quot; &quot; + s);"/>
    <elementParameter xmi:id="_OOGUwuh1Ee-fEOmmmXQ0Wg" field="MEMO_IMPORT" name="IMPORT" value="import org.apache.camel.Exchange;&#xA;import java.util.Base64;"/>
    <elementParameter xmi:id="_OOGUw-h1Ee-fEOmmmXQ0Wg" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_OOGUxOh1Ee-fEOmmmXQ0Wg" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
