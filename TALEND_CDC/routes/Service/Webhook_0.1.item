  <node xmi:id="_ye99du1AEe-TyfrhfOasbA" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="720" posY="560">
    <elementParameter xmi:id="_ye99d-1AEe-TyfrhfOasbA" field="TEXT" name="UNIQUE_NAME" value="cProcessor_1" show="false"/>
    <elementParameter xmi:id="_ye99eO1AEe-TyfrhfOasbA" field="MEMO_JAVA" name="CODE" value="// Talend Job Metadata&#xA;String talendRouteName = exchange.getContext().getName();  // Get the route name&#xA;&#xA;// System Metadata&#xA;String hostName = InetAddress.getLocalHost().getHostName();&#xA;String ipAddress = InetAddress.getLocalHost().getHostAddress();&#xA;String userName = System.getProperty(&quot;user.name&quot;);&#xA;String osName = System.getProperty(&quot;os.name&quot;);&#xA;String osVersion = System.getProperty(&quot;os.version&quot;);&#xA;String osArch = System.getProperty(&quot;os.arch&quot;);&#xA;int cpuCores = Runtime.getRuntime().availableProcessors();&#xA;long totalMemoryMB = Runtime.getRuntime().totalMemory() / (1024 * 1024);&#xA;long freeMemoryMB = Runtime.getRuntime().freeMemory() / (1024 * 1024);&#xA;long maxMemoryMB = Runtime.getRuntime().maxMemory() / (1024 * 1024);&#xA;String javaVersion = System.getProperty(&quot;java.version&quot;);&#xA;String javaVendor = System.getProperty(&quot;java.vendor&quot;);&#xA;String timezone = System.getProperty(&quot;user.timezone&quot;);&#xA;&#xA;// Get headers&#xA;String cmm = (String) exchange.getIn().getHeader(&quot;CMM&quot;);&#xA;String env = (String) exchange.getIn().getHeader(&quot;Environment&quot;);&#xA;String procesNr = (String) exchange.getIn().getHeader(&quot;ProcessingStepNr&quot;);&#xA;String procesStat = (String) exchange.getIn().getHeader(&quot;ProcessingStepStatus&quot;);&#xA;&#xA;// Ensure default values&#xA;if (env == null || env.trim().isEmpty()) {&#xA;    env = contextStr;&#xA;}&#xA;&#xA;if (cmm == null || cmm.trim().isEmpty()) {&#xA;    cmm = &quot;CMM_Unknown&quot;;&#xA;}&#xA;&#xA;if (procesNr == null || procesNr.trim().isEmpty()) {&#xA;    procesNr = &quot;0&quot;;&#xA;}&#xA;&#xA;if (procesStat == null || procesStat.trim().isEmpty()) {&#xA;    procesStat = &quot;Status_Unknown&quot;;&#xA;}&#xA;&#xA;// Parse JSON Headers for MessageIn&#xA;JSONObject messageInJson = new JSONObject();&#xA;try {&#xA;    String messageInHeader = (String) exchange.getIn().getHeader(&quot;MessageIn&quot;);&#xA;    if (messageInHeader != null &amp;&amp; !messageInHeader.trim().isEmpty()) {&#xA;        messageInJson = new JSONObject(messageInHeader);&#xA;    }&#xA;} catch (JSONException e) {&#xA;    System.err.println(&quot;Failed to parse 'MessageIn' header: &quot; + e.getMessage());&#xA;}&#xA;&#xA;&#xA;String newError = (String)exchange.getIn().getHeader(&quot;Error&quot;);&#xA;&#xA;&#xA;// Extract StartTime and EndTime&#xA;String startTimeStr = (String) exchange.getIn().getHeader(&quot;StartTime&quot;);&#xA;String endTimeStr = (String) exchange.getIn().getHeader(&quot;EndTime&quot;);&#xA;&#xA;// Initialize processingTime&#xA;long processingTime = 0;&#xA;boolean shouldProcessEndTime = endTimeStr != null &amp;&amp; !endTimeStr.trim().isEmpty();&#xA;&#xA;// Only calculate processing time if EndTime is available&#xA;if (shouldProcessEndTime &amp;&amp; startTimeStr != null &amp;&amp; !startTimeStr.trim().isEmpty()) {&#xA;    try {&#xA;        SimpleDateFormat dateFormat = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;);&#xA;        dateFormat.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;));&#xA;&#xA;        Date startTime = dateFormat.parse(startTimeStr);&#xA;        Date endTime = dateFormat.parse(endTimeStr);&#xA;&#xA;        processingTime = endTime.getTime() - startTime.getTime();&#xA;    } catch (ParseException e) {&#xA;        System.err.println(&quot;Failed to parse startTime or endTime: &quot; + e.getMessage());&#xA;    }&#xA;}&#xA;&#xA;// Build JSON output&#xA;JSONObject json = new JSONObject();&#xA;&#xA;json.put(&quot;StartTime&quot;, startTimeStr);&#xA;&#xA;// Only add EndTime and processingTime if EndTime is available&#xA;if (shouldProcessEndTime) {&#xA;    json.put(&quot;EndTime&quot;, endTimeStr);&#xA;    json.put(&quot;processingTimeMs&quot;, processingTime);&#xA;}&#xA;&#xA;&#xA;// Only process MessageOut if it's not empty&#xA;String messageOutHeader = (String) exchange.getIn().getHeader(&quot;MessageOut&quot;);&#xA;if (messageOutHeader != null &amp;&amp; !messageOutHeader.trim().isEmpty() &amp;&amp; messageOutHeader.trim().startsWith(&quot;{&quot;)) {&#xA;    try {&#xA;        JSONObject messageOutJson = new JSONObject(messageOutHeader);&#xA;        json.put(&quot;MessageOut&quot;, messageOutJson);&#xA;    } catch (JSONException e) {&#xA;        System.err.println(&quot;Failed to parse 'MessageOut' header: &quot; + e.getMessage());&#xA;    }&#xA;}&#xA;&#xA;json.put(&quot;Producer&quot;,(String)exchange.getIn().getHeader(&quot;Producer&quot;));&#xA;json.put(&quot;ProducerKey&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKey&quot;));&#xA;json.put(&quot;ProducerKeyId&quot;,(String)exchange.getIn().getHeader(&quot;ProducerKeyId&quot;));&#xA;json.put(&quot;IntegrationRunId&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId&quot;));&#xA;json.put(&quot;IntegrationRunId_SubNr&quot;,(String)exchange.getIn().getHeader(&quot;IntegrationRunId_SubNr&quot;));&#xA;json.put(&quot;Environment&quot;,env);&#xA;json.put(&quot;CMM&quot;,cmm);&#xA;json.put(&quot;ProcessingStep&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStep&quot;));&#xA;json.put(&quot;ProcessingStepNr&quot;,procesNr);&#xA;json.put(&quot;ProcessingStepTotal&quot;,(String)exchange.getIn().getHeader(&quot;ProcessingStepTotal&quot;));&#xA;json.put(&quot;ProcessingStepStatus&quot;,procesStat);&#xA;json.put(&quot;Consumer&quot;,(String)exchange.getIn().getHeader(&quot;Consumer&quot;));&#xA;json.put(&quot;ConsumerKey&quot;,(String)exchange.getIn().getHeader(&quot;ConsumerKey&quot;));&#xA;json.put(&quot;Description&quot;,&quot;Event triggered by '&quot;+ (String)exchange.getIn().getHeader(&quot;ProducerKey&quot;) + &quot;' destination '&quot; + (String)exchange.getIn().getHeader(&quot;ConsumerKey&quot;) +&quot;'&quot;);&#xA;json.put(&quot;Error&quot;,newError);&#xA;json.put(&quot;Link&quot;,(String)exchange.getIn().getHeader(&quot;Link&quot;));&#xA;json.put(&quot;MessageIn&quot;,messageInJson);&#xA;json.put(&quot;Webservice&quot;,(String)exchange.getIn().getHeader(&quot;Webservice&quot;));&#xA;&#xA;json.put(&quot;RouteName&quot;, talendRouteName);&#xA;&#xA;json.put(&quot;HostName&quot;, hostName);&#xA;json.put(&quot;IPAddress&quot;, ipAddress);&#xA;json.put(&quot;UserName&quot;, userName);&#xA;json.put(&quot;OSName&quot;, osName);&#xA;json.put(&quot;OSVersion&quot;, osVersion);&#xA;json.put(&quot;OSArchitecture&quot;, osArch);&#xA;json.put(&quot;CPU Cores&quot;, cpuCores);&#xA;json.put(&quot;TotalMemoryMB&quot;, totalMemoryMB);&#xA;json.put(&quot;FreeMemoryMB&quot;, freeMemoryMB);&#xA;json.put(&quot;MaxMemoryMB&quot;, maxMemoryMB);&#xA;json.put(&quot;JavaVersion&quot;, javaVersion);&#xA;json.put(&quot;JavaVendor&quot;, javaVendor);&#xA;json.put(&quot;Timezone&quot;, timezone);&#xA;&#xA;json.put(&quot;MonitoringSessionPid&quot;,&quot;pid&quot;);&#xA;json.put(&quot;MonitoringSessionRootPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#xA;json.put(&quot;MonitoringSessionFatherPid&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionPid&quot;));&#xA;json.put(&quot;MonitoringSessionJobName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobName&quot;));&#xA;json.put(&quot;MonitoringSessionJobVersion&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionJobVersion&quot;));&#xA;json.put(&quot;MonitoringSessionProjectName&quot;,(String)exchange.getIn().getHeader(&quot;MonitoringSessionProjectName&quot;));&#xA;&#xA;&#xA;String message;&#xA;message = json.toString();&#xA;&#xA;// Append a newline character&#xA;message += &quot;\n&quot;;&#xA;&#xA;exchange.getIn().setBody(message);&#xA;System.out.println(message);"/>
    <elementParameter xmi:id="_ye99ee1AEe-TyfrhfOasbA" field="MEMO_IMPORT" name="IMPORT" value="import java.util.List;&#xA;import java.util.Date;&#xA;import java.util.TimeZone;&#xA;import java.net.InetAddress;&#xA;import java.util.Enumeration;&#xA;import java.net.NetworkInterface;&#xA;import java.text.ParseException;&#xA;import java.text.SimpleDateFormat;&#xA;&#xA;&#xA;&#xA;"/>
    <elementParameter xmi:id="_ye99eu1AEe-TyfrhfOasbA" field="TEXT" name="LABEL" value="&lt;b>Parse JSON&lt;/b>"/>
    <elementParameter xmi:id="_ye99e-1AEe-TyfrhfOasbA" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_ye99fO1AEe-TyfrhfOasbA" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
